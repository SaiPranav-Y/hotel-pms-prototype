# ============================================================
#  Karivena Satram — Voice AI Platform  ·  Environment Config
# ------------------------------------------------------------
#  Copy this file to ".env" and fill in the values you need.
#      cp .env.example .env      (macOS/Linux)
#      copy .env.example .env    (Windows)
#
#  EVERYTHING IS OPTIONAL. With no .env at all, the app runs
#  fully in LOCAL / MOCK mode:
#    - LLM via local Ollama
#    - Bookings stored in memory
#    - Payments + WhatsApp simulated (mock links / logged sends)
#  Add real values only for the integrations you want to go live.
# ============================================================


# ---- Server -------------------------------------------------
# Where the FastAPI server binds. Defaults are fine for local use.
HOST=0.0.0.0
PORT=8000


# ---- Local LLM (Ollama) — REQUIRED for the AI brain ---------
# Install Ollama (https://ollama.com/download), then:  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# ---- Local Speech (optional; sensible defaults) -------------
# Whisper STT model size: tiny | base | small | medium
WHISPER_MODEL_SIZE=base
# Piper TTS voice
PIPER_VOICE=en_US-amy-medium


# ---- Firebase / Firestore (optional) ------------------------
# Leave FIREBASE_ENABLED=false to use in-memory storage (no setup).
# To persist bookings:
#   1. Firebase Console -> Project Settings -> Service Accounts
#   2. "Generate new private key" -> save as firebase-key.json in project root
#   3. Set FIREBASE_ENABLED=true
FIREBASE_ENABLED=false
# Optional: override the key path (defaults to ./firebase-key.json)
# FIREBASE_KEY_PATH=firebase-key.json


# ---- Razorpay Payments (optional) ---------------------------
# Without these, payment links are MOCK (fake but functional for demos).
# Get keys from the Razorpay dashboard (test: rzp_test_..., live: rzp_live_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay dashboard -> Settings -> Webhooks). Enables the
# automated payment-confirmation -> 80G certificate loop with signature checks.
RAZORPAY_WEBHOOK_SECRET=


# ---- WhatsApp (optional) ------------------------------------
# Without these, WhatsApp messages are logged in MOCK mode.
# Option A — Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Option B — a generic webhook to your existing WhatsApp bot:
WHATSAPP_WEBHOOK_URL=
