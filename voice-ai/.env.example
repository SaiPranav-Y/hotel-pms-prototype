# ============================================================
#  Karivena Satram — Voice AI Platform · Environment Config
# ------------------------------------------------------------
#  Copy this file to ".env" and fill in what you need.
#      cp .env.example .env       (macOS/Linux)
#      copy .env.example .env     (Windows)
#
#  With NO .env at all, the app still runs in LOCAL / MOCK mode:
#    - LLM via local Ollama
#    - Bookings in memory (no Firebase)
#    - Payments + WhatsApp simulated
#  Add real values only for the integrations you want live.
# ============================================================


# ---- Server -------------------------------------------------
HOST=0.0.0.0
PORT=8000


# ---- Local LLM (Ollama) — REQUIRED for the AI brain ---------
# Install Ollama (https://ollama.com/download), then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# ---- Local Speech (optional) --------------------------------
WHISPER_MODEL_SIZE=base           # tiny | base | small | medium
PIPER_VOICE=en_US-amy-medium


# ---- Firebase (optional but recommended) --------------------
# Persists bookings + enables shared staff login with the Flutter PMS.
#   1. Firebase console -> Project settings -> Service accounts
#      -> Generate new private key -> save as firebase-key.json in project root
#   2. Set FIREBASE_ENABLED=true
FIREBASE_ENABLED=false
FIREBASE_KEY_PATH=firebase-key.json
# Web API key (Firebase console -> Project settings -> General -> Web API Key).
# Lets the Voice-AI backend verify staff passwords against Firebase Auth — the
# SAME accounts the Flutter PMS logs in with. See AUTH.md.
FIREBASE_WEB_API_KEY=


# ---- Razorpay Payments (optional) ---------------------------
# Without keys, payment links are MOCK (or UPI deep links if UPI_VPA is set).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ---- UPI (optional) -----------------------------------------
# Set a UPI VPA to generate a real upi://pay deep link (opens GPay/PhonePe/Paytm)
# even before Razorpay live keys are configured.
UPI_VPA=
UPI_PAYEE_NAME=Karivena Satram


# ---- WhatsApp (optional) ------------------------------------
# Without these, WhatsApp messages are logged in MOCK mode.
# Option A — Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Option B — a generic webhook to your existing WhatsApp bot:
WHATSAPP_WEBHOOK_URL=
