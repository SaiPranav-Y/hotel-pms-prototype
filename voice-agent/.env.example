# Telugu Voice Agent — Phase 1 (text mode) configuration.
# Copy this file to `.env` and adjust as needed. All values have safe defaults;
# the agent runs fully offline with only a local Ollama model.

# --- LLM (local Ollama) ---------------------------------------------------
# The agent talks to a local Ollama server. Nothing is sent to the cloud.
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 (3B) is CPU-friendly and already pulled in dev. It is used ONLY for
# intent classification; all slot parsing is deterministic (see README).
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=60

# --- Database (self-contained SQLite) -------------------------------------
# Defaults to voice-agent/voice_agent.db. Point elsewhere to isolate data.
# VOICE_AGENT_DB=C:\path\to\voice_agent.db

# --- Hotel identity -------------------------------------------------------
HOTEL_NAME=Karivena Satram
TIMEZONE=Asia/Kolkata

# --- Data sources ---------------------------------------------------------
# Left blank, the app auto-discovers the sibling Karivena room/rate JSON.
# Set explicitly to override.
# ROOM_DATA_PATH=..\..\hotel-voice-booking-demo\app\room_data.json
# RATE_CONFIG_PATH=..\..\hotel-voice-booking-demo\app\rate_config.json

# --- Feature flags --------------------------------------------------------
# ALLOW_CLOUD_TTS must be true for spoken Telugu output via edge-tts (it sends
# text to Microsoft's free service). Text mode ignores it.
ALLOW_CLOUD_TTS=false
STORE_TRANSCRIPTS=false

# --- Speech-to-text (Phase 2, faster-whisper, local/offline) --------------
# Telugu ASR. On CPU use "base" or "small"; larger models are much slower.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=te
STT_BEAM_SIZE=1

# --- Text-to-speech (Phase 3) ---------------------------------------------
# Engine: "edge" (Telugu, needs network + ALLOW_CLOUD_TTS) or "piper"/"mms"
# (offline seam, not wired on this machine).
TTS_ENGINE=edge
# Natural Telugu neural voices: te-IN-ShrutiNeural (female), te-IN-MohanNeural (male).
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_VOICE_TE_ALT=te-IN-MohanNeural
# Prosody for a warmer, clearer voice. rate is +/-N%, pitch is +/-NHz.
TTS_RATE=-6%
TTS_PITCH=-2Hz
# TTS_CACHE_DIR=.tts_cache

# --- Local mic/speaker loop (Phase 4) -------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_SILENCE_RMS=0.01
AUDIO_SILENCE_SECS=1.2
AUDIO_MAX_TURN_SECS=15

# --- Live data integration (with hotel-voice-booking-demo) ----------------
# "sqlite" = self-contained offline DB (default). "live" = book against the
# Karivena knowledge_base (same data + Firestore as the PMS). Live bookings
# require the caller's phone, gotram, and email; the gotram must be in the
# approved community list.
DATA_SOURCE=sqlite
# Auto-discovered if the demo is a sibling folder; set to override.
# KARIVENA_DEMO_PATH=C:\GIT\voice Z\hotel-voice-booking-demo
# Optional fallback gotram if a caller can't supply one (empty = always ask).
DEFAULT_GOTRAM=

# --- WhatsApp text channel (Telugu, same dialogue as voice) ---------------
WHATSAPP_HOST=0.0.0.0
WHATSAPP_PORT=8100
WA_SESSION_TTL_SECS=1800
# Outbound send: leave all blank for MOCK mode (replies are logged, nothing
# leaves the machine). For real WhatsApp use ONE of:
#   Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
#   or a generic webhook to your existing bot:
WHATSAPP_WEBHOOK_URL=
# Token Meta uses to verify the webhook (GET /webhook).
WHATSAPP_VERIFY_TOKEN=karivena-verify
